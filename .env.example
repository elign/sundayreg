# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Which database to use -------------------------------------------------
# Set to 1 to run entirely on a local JSON file with no Firebase project.
# The app refuses to start with this set to 1 when NODE_ENV=production.
FIREBASE_USE_LOCAL_STORE=1

# --- Firebase service account ----------------------------------------------
# Only needed when FIREBASE_USE_LOCAL_STORE is not 1. Get these from
# Firebase console > Project settings > Service accounts > Generate new
# private key. See the README for the full walkthrough.

# Option A: paste the whole downloaded JSON file on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."

# Option B: set the three values individually (easier on Vercel).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes; \n escapes are converted automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Staff access ----------------------------------------------------------
# Shared password for /admin and /checkin. Use a long, unique one.
ADMIN_PASSWORD=
# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing this signs every volunteer out.
ADMIN_SESSION_SECRET=

# --- Localisation ----------------------------------------------------------
# IANA timezone used to decide which program day a visit belongs to.
# Must be the temple's timezone, not the server's.
TEMPLE_TIMEZONE=Asia/Kolkata

# Dialing code assumed when a visitor types a bare 10 digit number.
DEFAULT_COUNTRY_CODE=91

# --- Optional --------------------------------------------------------------
# Absolute site URL, if the app is behind a proxy that hides the real host.
# Used to build the URL inside the pass QR code.
# PUBLIC_BASE_URL=https://sundaypass.example.org
